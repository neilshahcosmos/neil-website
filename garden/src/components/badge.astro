---
import BadgeIcon from './badgeicon.astro'
import { STAGE_INFO } from '../lib/garden'
interface Props {
    stage: 'nebula' | 'protostar' | 'star';
    compact?: boolean;
}
const {
    stage,
    compact = false,
} = Astro.props
const info = STAGE_INFO[stage]
---

<span class:list={['badge', `stage-${stage}`, { compact }]} title={`${info.label}: ${info.blurb}`}>
    <BadgeIcon stage={stage} size={compact ? 14 : 16} />
    {!compact && <span>{info.label}</span>}
</span>

<style>
    .badge {
        display: inline-flex;
        align-items: center;
        gap: 0.5em;
        font-family: var(--font-mono);
        font-size: 0.7rem;
        letter-spacing: 0.1em;
        text-transform: uppercase;
        padding: 0.28em 0.70em 0.28em 0.55em;
        border-radius: 999px;
        border: 1px solid var(--border);
        background: var(--surface);
        white-space: nowrap;
    }
    .stage-nebula {
        color: var(--nebula);
    }
    .stage-protostar {
        color: var(--protostar);
    }
    .stage-star {
        color: var(--star);
    }
    .compact {
        padding: 0;
        border: 0;
        background: none;
    }
</style>
