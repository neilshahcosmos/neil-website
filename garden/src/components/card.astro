---
/* 
 * Card for any garden entry
 * `variant="feature"` shows the cover image
 * `variant="row"` is a compact title line (for thoughts)
 */

import "../styles/global.css";
import { get_url_from_entry, fmt_date, PAGE_TYPE_LABEL, type Entry  } from '../lib/garden';

import Badge from './badge.astro';

interface Props {
    entry: Entry;
    show_page_type?: boolean
};
const {
    entry,
    show_page_type,
} = Astro.props;

const data = entry.data as any;
const href = get_url_from_entry(entry);
const page_type_label = PAGE_TYPE_LABEL[entry.collection].one;
---

<a class="card" href={href} data-preview>
    <div class="card-cover">
        {data.cover ? <img src={data.cover} alt="" loading="lazy" /> : <div class="cover-fallback"></div>}
    </div>
    <div class="card-body">
        <div class="card-meta">
            <span class="eyebrow">{fmt_date(data.date)}</span>
            <Badge stage={data.stage} />
        </div>
        <h3 class="card-title">{data.title}</h3>
        {data.subtitle && <p class="subtitle">{data.subtitle}</p>}
        <p class="card-desc">{data.description}</p>
    </div>
</a>

<style>
    .card {
        position: relative;
        display: flex;
        flex-direction: column;
        height: 100%;
        border-radius: var(--radius);
        border: 1px solid var(--border);
        background: linear-gradient(180deg, rgba(255,255,255,0.045), rgba(255,255,255,0.015));
        color: var(--text);
        text-decoration: none;
        overflow: hidden;
        transition: transform 0.25s cubic-bezier(0.20, 0.80, 0.20, 1.00), border-color 0.25s, box-shadow 0.25s;
    }
    .card:hover {
        transform: translateY(-4px);
        border-color: var(--border-strong);
        box-shadow: 0 20px 45px rgba(0, 0, 0, 0.50), 0 0 40px rgba(150, 110, 230, 0.10);
    }
    .card-cover {
        position: relative;
        aspect-ratio: 16.0 / 9.0;
        overflow: hidden;
        background: #05050d;
    }
    .card-cover img {
        width: 100%;
        height: 100%;
        object-fit: cover;
        transition: transform 0.6s cubic-bezier(0.20, 0.80, 0.20, 1.00);
    }
    .card:hover .card-cover img {
        transform: scale(1.06);
    }
    .cover-fallback {
        width: 100%;
        height: 100%;
        background: radial-gradient(ellipse at 70% 30%, rgba(196,154,245,0.35), transparent 60%), 
                    radial-gradient(ellipse at 20% 80%, rgba(127,216,234,0.25), transparent 60%), 
                    #08081a;
    }
    .card-body {
        padding: 1.1rem 1.2rem 1.3rem;
        display: flex;
        flex-direction: column;
        gap: 0.35rem;
    }
    .card-meta {
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 0.5rem;
        margin-bottom: 0.3rem;
    }
    .card-title {
        font-size: var(--font-size-1);
        margin: 0;
    }
    .card-subtitle {
        margin: 0;
        color: var(--muted);
        font-family: var(--font-display);
        font-style: italic;
    }
    .card-desc {
        margin: 0;
        color: var(--muted);
        font-size: 0.95rem;
        line-height: 1.50;
    }
</style>
