---
// Animated star field for the homepage hero: drifting, twinkling stars at
// three depths with gentle mouse parallax and the odd shooting star.
// Pauses when off-screen or in a background tab; static if the visitor
// prefers reduced motion.
---
<canvas class="starfield" aria-hidden="true"></canvas>

<style>
  .starfield { position: absolute; inset: 0; width: 100%; height: 100%; display: block; }
</style>

<script>
  for (const canvas of document.querySelectorAll<HTMLCanvasElement>('canvas.starfield')) {
    const ctx = canvas.getContext('2d')!;
    const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;
    type Star = { x: number; y: number; z: number; r: number; tw: number; sp: number; hue: string };
    let stars: Star[] = [];
    let w = 0, h = 0, dpr = 1;
    let mx = 0, my = 0, px = 0, py = 0;
    let visible = true;
    let shoot: { x: number; y: number; vx: number; vy: number; life: number } | null = null;
    let nextShoot = performance.now() + 4000;
    const hues = ['255,255,255', '255,240,220', '210,225,255', '255,220,200', '225,210,255'];

    function resize() {
      dpr = Math.min(window.devicePixelRatio || 1, 2);
      w = canvas.clientWidth; h = canvas.clientHeight;
      canvas.width = w * dpr; canvas.height = h * dpr;
      ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
      const n = Math.round((w * h) / 2600);
      stars = Array.from({ length: n }, () => {
        const z = Math.random() ** 2; // most stars are far away
        return {
          x: Math.random() * w, y: Math.random() * h, z,
          r: 0.35 + z * 1.5, tw: Math.random() * Math.PI * 2, sp: 0.5 + Math.random() * 1.5,
          hue: hues[(Math.random() * hues.length) | 0],
        };
      });
    }

    function draw(t: number) {
      ctx.clearRect(0, 0, w, h);
      px += (mx - px) * 0.04; py += (my - py) * 0.04;
      for (const s of stars) {
        if (!reduce) { s.x -= 0.02 + s.z * 0.12; if (s.x < -2) s.x = w + 2; }
        const x = s.x + px * s.z * 18, y = s.y + py * s.z * 12;
        const a = reduce ? 0.8 : 0.45 + 0.55 * (0.5 + 0.5 * Math.sin(t / 1000 * s.sp + s.tw));
        ctx.globalAlpha = a * (0.35 + s.z * 0.65);
        ctx.fillStyle = `rgb(${s.hue})`;
        ctx.beginPath(); ctx.arc(x, y, s.r, 0, Math.PI * 2); ctx.fill();
        if (s.r > 1.5) { // a soft glow on the nearest stars
          const g = ctx.createRadialGradient(x, y, 0, x, y, s.r * 5);
          g.addColorStop(0, `rgba(${s.hue},${0.35 * a})`); g.addColorStop(1, `rgba(${s.hue},0)`);
          ctx.globalAlpha = 1; ctx.fillStyle = g;
          ctx.beginPath(); ctx.arc(x, y, s.r * 5, 0, Math.PI * 2); ctx.fill();
        }
      }
      ctx.globalAlpha = 1;
      if (!reduce) {
        if (!shoot && t > nextShoot) {
          shoot = { x: Math.random() * w * 0.7 + w * 0.3, y: Math.random() * h * 0.4, vx: -7 - Math.random() * 4, vy: 3 + Math.random() * 2, life: 1 };
        }
        if (shoot) {
          const g = ctx.createLinearGradient(shoot.x, shoot.y, shoot.x - shoot.vx * 12, shoot.y - shoot.vy * 12);
          g.addColorStop(0, `rgba(255,255,255,${shoot.life})`); g.addColorStop(1, 'rgba(255,255,255,0)');
          ctx.strokeStyle = g; ctx.lineWidth = 1.3;
          ctx.beginPath(); ctx.moveTo(shoot.x, shoot.y); ctx.lineTo(shoot.x - shoot.vx * 12, shoot.y - shoot.vy * 12); ctx.stroke();
          shoot.x += shoot.vx; shoot.y += shoot.vy; shoot.life -= 0.018;
          if (shoot.life <= 0) { shoot = null; nextShoot = t + 6000 + Math.random() * 9000; }
        }
      }
    }

    function loop(t: number) {
      if (visible && !document.hidden) draw(t);
      if (!reduce) requestAnimationFrame(loop);
    }

    resize();
    new ResizeObserver(resize).observe(canvas);
    new IntersectionObserver(([e]) => (visible = e.isIntersecting)).observe(canvas);
    window.addEventListener('pointermove', (e) => {
      mx = e.clientX / window.innerWidth - 0.5; my = e.clientY / window.innerHeight - 0.5;
    }, { passive: true });
    if (reduce) draw(0); else requestAnimationFrame(loop);
  }
</script>
